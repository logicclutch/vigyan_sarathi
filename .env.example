# ---- Site ----
# Public site URL used for canonical links, Open Graph images and the sitemap (no trailing slash).
# Not needed when deploying with docker-compose: it is derived from SITE_DOMAIN below.
VITE_SITE_URL=

# Optional: an HTTPS endpoint that accepts a JSON POST from the contact form
# (for example a Formspree form endpoint). When empty, the form falls back to a
# prefilled mailto: link using the email configured in src/content/site.ts.
VITE_CONTACT_ENDPOINT=

# ---- Docker / Traefik deployment (VPS) ----
# Domain the site is served on (DNS A record must point at the VPS).
SITE_DOMAIN=vigyansarathi.example
# Names from your existing Traefik setup: `docker network ls`, and the entrypoint /
# certresolver names in your Traefik config (traefik.yml or its compose labels).
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_CERTRESOLVER=letsencrypt
