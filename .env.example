# Public site URL used for canonical links, Open Graph images and the sitemap (no trailing slash).
VITE_SITE_URL=https://example.org

# Optional: an HTTPS endpoint that accepts a JSON POST from the contact form
# (for example a Formspree form endpoint). When empty, the form falls back to a
# prefilled mailto: link using the email configured in src/content/site.ts.
VITE_CONTACT_ENDPOINT=
